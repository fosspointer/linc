// Simplified re-implementation of the Logger::format() function in Linc.
#include `std.linc`

fn println(str: mut string, args: string[]) {
    output: mut string;
    index mut := 0us;
    str += 0c;

    for i mut := 0us; i < +str - 1us; ++i {
        if str[i] != '$' { putc(str[i]); continue; };
        if i < +str - 2us && str[i + 1us] == '$' {
            putc('$');
            ++i;
        }    
        else {
            if index >= +args { puts("Error: Argument '$' not found.\n"); sys_exit(-1); };
            puts(args[index]);
            ++index;
        }
    };
    putc('\n');
}

fn main() {
    fruit := ["🥭", "🍎", "🫐", "🍌"];
    println(f"my favorite fruit: ${fruit}!");
}