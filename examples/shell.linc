#include `std.linc`

fn parseI32(str: string): i32 {
    result: mut i32 = 0i32;
    negative: mut bool = false;

    if str[0us] == '-'
        negative = true;

    for index mut := if negative 1us else 0us; index < +str; ++index
        if +str[index] >= +'0' && +str[index] <= +'9'
            result = result * 10 + (+str[index] - +'0');

    if negative
        result = -result;

    result
}

fn main(args: string[]) {
    result: mut i32 = parseI32(system("date +%H"));

    if +args == 3us result = parseI32(args[2us]);
    putln("It is " + if result > 23 || result < 0 "an error!" else if result < 12 "too early" else if result == 12 "just right" else "too late");
}
